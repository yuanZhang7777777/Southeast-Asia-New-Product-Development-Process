APP_ENV=local
APP_NAME=Hengzhe New Product Workflow
POSTGRES_DB=workflow
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
# Production/shared deployments must use PostgreSQL. SQLite is only for local tests/dev smoke.
DATABASE_URL=postgresql+psycopg://workflow:change-me@postgres:5432/workflow
# Local-only example: DATABASE_URL=sqlite:///./workflow_dev.db
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DINGTALK_CORP_ID=
DINGTALK_WEBHOOK_URL=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_ROBOT_CODE=
DINGTALK_ARRIVAL_CARD_TEMPLATE_ID=
DINGTALK_CARD_AUTOSEND_ENABLED=false
WORKFLOW_AUTOMATION_ENABLED=false
DINGTALK_CARD_TEST_RECEIVER_NAME=
# Test recipient mode: when set, ALL DingTalk cards are delivered to this dingtalk userId instead of the real receivers.
DINGTALK_TEST_RECIPIENT_USER_ID=
DINGTALK_USER_SYNC_ENABLED=false
# Public web URL used by DingTalk card action buttons (e.g. arrival "去处理"). Set it for the deployed environment.
PLATFORM_BASE_URL=http://127.0.0.1:5173
AUTH_REQUIRED=false
AUTH_SECRET_KEY=change-this-in-production
AUTH_TOKEN_TTL_SECONDS=86400
WRITE_BACK_TO_ONLINE_SHEETS=false

# PLM daily export. Keep real credentials only in the deployment .env.
PLM_SYNC_ENABLED=false
PLM_BASE_URL=http://103.198.125.2:7878
PLM_OPEN_BASE_URL=http://103.198.125.2:16777/open
PLM_USERNAME=
PLM_PASSWORD=
PLM_BLOC_NAME=集团八部
PLM_CACHE_DIR=/data/plm

# ERP product volume lookup. Keep business URLs and credentials in deployment .env only.
ERP_LOGIN_URL=
ERP_PRODUCT_LIST_URL=
ERP_DOWNLOAD_LIST_URL=
ERP_USERNAME=
ERP_PASSWORD=

OSS_UPLOAD_ENABLED=false
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=hz-sea-np-flow-prod
OSS_PUBLIC_BASE_URL=https://hz-sea-np-flow-prod.oss-cn-shanghai.aliyuncs.com
# Do not commit real keys. Local Codex uses C:\Users\86173\.codex\secrets\Hengzhe-New-Product-Workflow\oss.credentials.json.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_CREDENTIALS_FILE=
